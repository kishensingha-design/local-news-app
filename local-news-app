<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CityNews App</title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans text-gray-900 min-h-screen flex flex-col">

    <!-- Header & City Selector -->
    <header class="bg-blue-600 text-white p-4 shadow-md sticky top-0 z-10">
        <div class="max-w-md mx-auto flex flex-col gap-3">
            <h1 class="text-xl font-bold">Local News Feed</h1>
            <div class="relative">
                <select id="citySelector" class="w-full p-2 rounded bg-white text-gray-800 border-none shadow-sm focus:ring-2 focus:ring-blue-300">
                    <option value="Patna">Patna</option>
                    <option value="Jaipur">Jaipur</option>
                    <option value="Delhi">Delhi</option>
                </select>
            </div>
        </div>
    </header>

    <!-- News Feed Section -->
    <main class="flex-grow p-4 max-w-md mx-auto w-full">
        <div id="newsFeed" class="space-y-4">
            <!-- Loading State -->
            <p id="statusMsg" class="text-center text-gray-500 py-10">Select a city to load news...</p>
        </div>
    </main>

    <!-- Feedback Form Section -->
    <footer class="bg-white border-t border-gray-200 p-6">
        <div class="max-w-md mx-auto">
            <h2 class="text-lg font-semibold mb-3">Submit Feedback</h2>
            <form id="feedbackForm" class="space-y-3">
                <textarea id="feedbackText" required placeholder="Tell us what you think..." 
                    class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 h-24"></textarea>
                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg font-medium hover:bg-blue-700 transition">
                    Send Suggestion
                </button>
            </form>
            <p id="formFeedback" class="mt-2 text-sm hidden"></p>
        </div>
    </footer>

    <!-- Firebase SDK Setup -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getFirestore, collection, addDoc, query, where, getDocs, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        // 1. YOUR FIREBASE CONFIG
        const firebaseConfig = {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_PROJECT_ID.appspot.com",
            messagingSenderId: "YOUR_SENDER_ID",
            appId: "YOUR_APP_ID"
        };

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // UI Elements
        const citySelector = document.getElementById('citySelector');
        const newsFeed = document.getElementById('newsFeed');
        const statusMsg = document.getElementById('statusMsg');
        const feedbackForm = document.getElementById('feedbackForm');
        const formFeedback = document.getElementById('formFeedback');

        // --- FETCH NEWS LOGIC ---
        async function fetchNews(city) {
            newsFeed.innerHTML = '<p class="text-center text-gray-500 py-10">Loading stories...</p>';
            
            try {
                const q = query(collection(db, "news"), where("city", "==", city));
                const querySnapshot = await getDocs(q);
                
                if (querySnapshot.empty) {
                    newsFeed.innerHTML = '<p class="text-center text-gray-500 py-10">No news found for this city.</p>';
                    return;
                }

                newsFeed.innerHTML = '';
                querySnapshot.forEach((doc) => {
                    const data = doc.data();
                    const newsItem = document.createElement('div');
                    newsItem.className = "bg-white p-4 rounded-xl shadow-sm border border-gray-100";
                    newsItem.innerHTML = `
                        <h3 class="font-bold text-lg mb-1">${data.title || 'Untitled'}</h3>
                        <p class="text-gray-600 text-sm mb-3">${data.summary || ''}</p>
                        <button onclick="window.copyToClipboard('${data.link || '#'}')" 
                            class="text-blue-600 text-xs font-semibold flex items-center gap-1 uppercase tracking-wide">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            Share Link
                        </button>
                    `;
                    newsFeed.appendChild(newsItem);
                });
            } catch (error) {
                console.error("Error fetching news: ", error);
                newsFeed.innerHTML = '<p class="text-red-500 text-center">Failed to load news. Check console.</p>';
            }
        }

        // --- SUBMIT FEEDBACK LOGIC ---
        feedbackForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = document.getElementById('feedbackText').value;
            
            try {
                await addDoc(collection(db, "feedback"), {
                    suggestion: text,
                    timestamp: serverTimestamp(),
                    city: citySelector.value
                });
                formFeedback.innerText = "Thanks for your feedback!";
                formFeedback.className = "mt-2 text-sm text-green-600";
                formFeedback.classList.remove('hidden');
                feedbackForm.reset();
            } catch (error) {
                formFeedback.innerText = "Error saving feedback.";
                formFeedback.className = "mt-2 text-sm text-red-600";
            }
        });

        // --- UTILITY: SHARE/COPY LINK ---
        window.copyToClipboard = (text) => {
            navigator.clipboard.writeText(text).then(() => {
                alert("Link copied to clipboard!");
            }).catch(err => {
                console.error('Could not copy text: ', err);
            });
        };

        // Initial Load & Event Listeners
        citySelector.addEventListener('change', (e) => fetchNews(e.target.value));
        fetchNews(citySelector.value); // Initial fetch for default city
    </script>
</body>
</html>